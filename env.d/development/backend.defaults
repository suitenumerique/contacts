# Django
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=ThisIsAnExampleKeyForDevPurposeOnly
DJANGO_SETTINGS_MODULE=contacts.settings

# Logging
# Set to DEBUG level for dev only
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO

# Python
PYTHONPATH=/app

# Static files
STORAGES_STATICFILES_BACKEND=django.contrib.staticfiles.storage.StaticFilesStorage

# OIDC - Keycloak on dedicated port 8975
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/contacts/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8975/realms/contacts/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/realms/contacts/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8080/realms/contacts/protocol/openid-connect/userinfo

OIDC_RP_CLIENT_ID=contacts
OIDC_RP_CLIENT_SECRET=ThisIsAnExampleKeyForDevPurposeOnly
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email"

LOGIN_REDIRECT_URL=http://localhost:8970
LOGIN_REDIRECT_URL_FAILURE=http://localhost:8970
LOGOUT_REDIRECT_URL=http://localhost:8970

# host:port, compared with the netloc of the post-login redirect URL
OIDC_REDIRECT_ALLOWED_HOSTS=localhost:8970
OIDC_AUTH_REQUEST_EXTRA_PARAMS={"acr_values": "eidas1"}

OIDC_OP_URL=http://localhost:8975/realms/contacts

# Frontend
FRONTEND_THEME=anct-light
FRONTEND_LAGAUFRE_ENABLED=true
FRONTEND_MORE_LINK=https://lasuite.numerique.gouv.fr
FRONTEND_FEEDBACK_BUTTON_SHOW=True
FRONTEND_FEEDBACK_BUTTON_IDLE=False
FRONTEND_FEEDBACK_ITEMS={}
FRONTEND_FEEDBACK_MESSAGES_WIDGET_ENABLED=False
FRONTEND_FEEDBACK_MESSAGES_WIDGET_API_URL=
FRONTEND_FEEDBACK_MESSAGES_WIDGET_CHANNEL=
FRONTEND_FEEDBACK_MESSAGES_WIDGET_PATH=

# Store OIDC tokens in the session
# OIDC_STORE_ACCESS_TOKEN = True
# OIDC_STORE_REFRESH_TOKEN = True # Store the encrypted refresh token in the session.
# Must be a valid Fernet key (32 url-safe base64-encoded bytes)
# To create one, use the bin/fernetkey command.
# OIDC_STORE_REFRESH_TOKEN_KEY="your-32-byte-encryption-key=="

# OIDC - Resource server: /external_api/ for other Suite apps (see
# docs/resource_server.md). The "drive" client of the dev realm stands for
# a consumer app.
OIDC_RESOURCE_SERVER_ENABLED=True
OIDC_OP_INTROSPECTION_ENDPOINT=http://keycloak:8080/realms/contacts/protocol/openid-connect/token/introspect
OIDC_RS_CLIENT_ID=contacts
OIDC_RS_CLIENT_SECRET=ThisIsAnExampleKeyForDevPurposeOnly
OIDC_RS_ALLOWED_AUDIENCES=drive
OIDC_RS_CREATE_USER=True
